#!/usr/bin/env xdg-open
[Desktop Entry]
Version=1.0
Terminal=false
Type=Application
Name=YouTube
Exec=/opt/google/chrome/google-chrome --silent-debugger-extension-api --profile-directory=Default --app-id=agimnkijcaahngcdmfeangaknmldooml
Icon=chrome-agimnkijcaahngcdmfeangaknmldooml-Default
StartupWMClass=crx_agimnkijcaahngcdmfeangaknmldooml
Actions=Shorts;Subscription;Telusuri

[Desktop Action Shorts]
Name=Shorts
Exec=/opt/google/chrome/google-chrome --silent-debugger-extension-api --profile-directory=Default --app-id=agimnkijcaahngcdmfeangaknmldooml "--app-launch-url-for-shortcuts-menu-item=https://www.youtube.com/shorts?feature=app_shortcuts"

[Desktop Action Subscription]
Name=Subscription
Exec=/opt/google/chrome/google-chrome --silent-debugger-extension-api --profile-directory=Default --app-id=agimnkijcaahngcdmfeangaknmldooml "--app-launch-url-for-shortcuts-menu-item=https://www.youtube.com/feed/subscriptions?feature=app_shortcuts"

[Desktop Action Telusuri]
Name=Telusuri
Exec=/opt/google/chrome/google-chrome --silent-debugger-extension-api --profile-directory=Default --app-id=agimnkijcaahngcdmfeangaknmldooml "--app-launch-url-for-shortcuts-menu-item=https://www.youtube.com/results?feature=app_shortcuts"
